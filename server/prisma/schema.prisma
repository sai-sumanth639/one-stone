// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES
  PRODUCTION
  ACCOUNTANT
}

enum BlockStatus {
  IN_STOCK
  PROCESSING
  PROCESSED
}

enum SlabStatus {
  AVAILABLE
  RESERVED
  SOLD
  DAMAGED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum TransactionType {
  CREDIT
  DEBIT
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(SALES)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  gstin     String?
  blocks    Block[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String       @id @default(uuid())
  name      String
  phone     String?
  email     String?
  address   String?
  gstin     String?
  orders    SalesOrder[]
  transactions Transaction[] // Linked to payments
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Block {
  id            String      @id @default(uuid())
  blockNumber   String      @unique
  supplierId    String
  supplier      Supplier    @relation(fields: [supplierId], references: [id])
  purchaseDate  DateTime
  length        Float       // In inches or cm
  height        Float
  width         Float
  weight        Float?
  purchasePrice Float
  transportCost Float       @default(0)
  otherExpenses Float       @default(0)
  totalCost     Float       // Calculated
  status        BlockStatus @default(IN_STOCK)
  slabs         Slab[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Slab {
  id            String      @id @default(uuid())
  slabNo        String      // e.g., B1-S1
  blockId       String
  block         Block       @relation(fields: [blockId], references: [id])
  length        Float
  width         Float
  thickness     Float       // usually in mm
  sqFt          Float       // Calculated: (L * W) / 144 if inches
  finish        String?     // Polished, Honed, etc.
  grade         String?     // Premium, Standard, Commercial
  location      String?
  status        SlabStatus  @default(AVAILABLE)
  sellingPrice  Float?      // Price per sqft set for sales
  orderItems    SalesOrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([blockId, slabNo])
}

model SalesOrder {
  id            String           @id @default(uuid())
  orderNumber   Int              @default(autoincrement()) @unique
  customerId    String
  customer      Customer         @relation(fields: [customerId], references: [id])
  orderDate     DateTime         @default(now())
  totalAmount   Float
  discount      Float            @default(0)
  taxAmount     Float            @default(0)
  finalAmount   Float
  status        OrderStatus      @default(PENDING)
  items         SalesOrderItem[]
  invoices      Invoice[]
  dispatch      Dispatch?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model SalesOrderItem {
  id          String     @id @default(uuid())
  orderId     String
  order       SalesOrder @relation(fields: [orderId], references: [id])
  slabId      String     @unique
  slab        Slab       @relation(fields: [slabId], references: [id])
  pricePerSqFt Float
  totalPrice  Float
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  orderId       String
  order         SalesOrder    @relation(fields: [orderId], references: [id])
  date          DateTime      @default(now())
  amount        Float
  paidAmount    Float         @default(0)
  status        PaymentStatus @default(UNPAID)
  transactions  Transaction[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Dispatch {
  id            String     @id @default(uuid())
  orderId       String     @unique
  order         SalesOrder @relation(fields: [orderId], references: [id])
  driverName    String?
  vehicleNumber String?
  dispatchDate  DateTime   @default(now())
  status        String     // e.g., 'In Transit', 'Delivered'
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Transaction {
  id            String          @id @default(uuid())
  date          DateTime        @default(now())
  amount        Float
  type          TransactionType // CREDIT (Income), DEBIT (Expense)
  category      String          // 'Sales', 'Purchase', 'Salary', 'Utility'
  description   String?
  
  // Relations
  invoiceId     String?
  invoice       Invoice?        @relation(fields: [invoiceId], references: [id])
  customerId    String?
  customer      Customer?       @relation(fields: [customerId], references: [id])
  
  paymentMode   String?         // 'Cash', 'Bank Transfer', 'Cheque'
  referenceNo   String?         // Cheque number or Transaction ID
  
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Expense {
  id          String   @id @default(uuid())
  category    String   // Labor, Electricity, etc.
  amount      Float
  date        DateTime @default(now())
  description String?
  paidBy      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
